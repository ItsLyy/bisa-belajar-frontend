{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Schema definitions for Bisa Belajar application data models",
  "definitions": {
    "ISkill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the skill"
        },
        "name": {
          "type": "string",
          "description": "Display name of the skill"
        },
        "category": {
          "type": "string",
          "description": "Category classification (Frontend, Backend, Design Tools, etc.)"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the skill"
        },
        "timestamps": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the skill was created/updated"
        }
      },
      "required": ["id", "name", "category", "description", "timestamps"]
    },
    "IUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user"
        },
        "name": {
          "type": "string",
          "description": "Full display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "password": {
          "type": "string",
          "description": "Hashed password (never store plain text)"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Geographic latitude coordinate"
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Geographic longitude coordinate"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "description": "User reputation/achievement score"
        },
        "avatar_path": {
          "type": "string",
          "description": "Path/URL to user's profile avatar image"
        },
        "bio": {
          "type": "string",
          "description": "User's biography/description"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ISkill"
          },
          "description": "Array of skills the user possesses"
        },
        "timestamps": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the user was created/updated"
        }
      },
      "required": ["id", "name", "email", "password", "latitude", "longitude", "score", "skills", "timestamps"]
    },
    "ICourse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the course"
        },
        "title": {
          "type": "string",
          "description": "Course title/name"
        },
        "description": {
          "type": "string",
          "description": "Detailed course description"
        },
        "timestamps": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the course was created/updated"
        }
      },
      "required": ["id", "title", "description", "timestamps"]
    },
    "IPost": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the post"
        },
        "user": {
          "$ref": "#/definitions/IUser",
          "description": "User who created the post"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IPost"
          },
          "description": "Nested replies/threaded comments under this post"
        },
        "title": {
          "type": "string",
          "description": "Post title/headline"
        },
        "content": {
          "type": "string",
          "description": "Main content/body of the post"
        },
        "photo_url": {
          "type": "string",
          "description": "Optional image/photo URL attached to the post"
        },
        "course": {
          "$ref": "#/definitions/ICourse",
          "description": "Optional course reference if post is related to a specific course"
        },
        "timestamps": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the post was created/updated"
        }
      },
      "required": ["id", "user", "threads", "title", "content", "timestamps"]
    }
  },
  "dataFiles": {
    "users.json": {
      "description": "User accounts and profiles data",
      "structure": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IUser"
          }
        }
      }
    },
    "courses.json": {
      "description": "Course catalog and metadata",
      "structure": {
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ICourse"
          }
        }
      }
    },
    "posts.json": {
      "description": "Forum posts, discussions, and threaded conversations",
      "structure": {
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IPost"
          }
        }
      }
    },
    "skills.json": {
      "description": "Available skills catalog for users and courses",
      "structure": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ISkill"
          }
        }
      }
    }
  },
  "metadata": {
    "version": "1.0.0",
    "lastUpdated": "2024-01-23T00:00:00Z",
    "description": "Complete data schema for Bisa Belajar learning platform",
    "notes": [
      "All timestamps follow ISO 8601 format (YYYY-MM-DDTHH:mm:ssZ)",
      "IDs are unique strings following pattern: {type}_{sequential_number}",
      "Optional fields are marked with ? in TypeScript interfaces",
      "Geographic coordinates use decimal degrees format",
      "Passwords must always be hashed (bcrypt recommended)"
    ]
  }
}